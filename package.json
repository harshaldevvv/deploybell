{
  "name": "cloudflare-pages-notifier",
  "version": "1.0.0",
  "description": "Background system daemon and GUI that alerts you with loud sounds and native desktop notifications when Cloudflare Pages builds complete.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "cli": "node index.js",
    "cli:configure": "node index.js --config",
    "cli:test-notify": "node index.js --test",
    "build:cli": "pkg . --targets node18-win-x64 --output dist/cf-pages-notifier-cli.exe",
    "dist": "electron-builder"
  },
  "bin": "index.js",
  "pkg": {
    "assets": [
      "sounds/**/*"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "build": {
    "appId": "com.cloudflare.pages.notifier",
    "productName": "Cloudflare Pages Notifier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "sounds/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cloudflare Pages Notifier",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
