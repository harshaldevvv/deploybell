{
  "name": "deploybell",
  "version": "1.1.0",
  "description": "DeployBell: a desktop app that rings the moment your Cloudflare Pages build succeeds or fails.",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "cli": "node index.js",
    "cli:configure": "node index.js --config",
    "cli:test-notify": "node index.js --test",
    "build:cli": "pkg . --targets node18-win-x64 --output dist/deploybell-cli.exe",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "bin": "index.js",
  "pkg": {
    "assets": [
      "sounds/**/*"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.harshal.deploybell",
    "productName": "DeployBell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "sounds/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeployBell",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "artifactName": "DeployBell-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "harshaldevvv",
        "repo": "deploybell",
        "releaseType": "draft"
      }
    ],
    "portable": {
      "artifactName": "DeployBell-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "Desktop alerts for Cloudflare Pages deployments"
    }
  },
  "author": {
    "name": "Harshal",
    "email": "94016809+harshaldevvv@users.noreply.github.com",
    "url": "https://harshal.dev"
  },
  "homepage": "https://github.com/harshaldevvv/deploybell",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshaldevvv/deploybell.git"
  }
}
